{
 "$description": "postkit.org design tokens. Source of truth for libs/site-theme. Values extracted from the canvas boards (Nov 2026). Dark values match the dark boards.",
 "font": {
  "sans": {
   "value": "'Suisse Int\\'l', 'Inter Tight', system-ui, sans-serif",
   "note": "Boards use Inter Tight as a stand-in. Ryan supplies Suisse Int'l (licence and delivery) at implementation."
  },
  "mono": {
   "value": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
  }
 },
 "fontWeight": {
  "regular": 400,
  "medium": 500,
  "semibold": 600
 },
 "fontSize": {
  "2xs": "11px",
  "xs": "12px",
  "sm": "13px",
  "md": "15px",
  "body": "17px",
  "lg": "19px",
  "xl": "24px",
  "2xl": "28px",
  "3xl": "34px",
  "4xl": "44px",
  "5xl": "64px",
  "display": "clamp(40px, 5.6vw, 76px)",
  "hero": "clamp(44px, 6.4vw, 88px)",
  "section": "clamp(34px, 4.4vw, 56px)"
 },
 "lineHeight": {
  "tight": 1.04,
  "heading": 1.15,
  "snug": 1.4,
  "body": 1.5,
  "prose": 1.65
 },
 "letterSpacing": {
  "display": "-0.03em",
  "heading": "-0.02em",
  "tight": "-0.01em"
 },
 "radius": {
  "xs": "4px",
  "sm": "8px",
  "md": "12px",
  "lg": "14px",
  "xl": "16px",
  "2xl": "20px",
  "3xl": "28px",
  "full": "999px"
 },
 "space": {
  "gutter": "24px",
  "section": "96px",
  "sectionPhone": "64px"
 },
 "size": {
  "content": "1280px",
  "docs": "1280px",
  "prose": "680px",
  "docsMain": "720px",
  "sidenote": "192px",
  "sidenoteGap": "28px",
  "header": "56px",
  "tap": "44px"
 },
 "breakpoint": {
  "md": "761px — desktop from here; the boards' phone rule is max-width 760px",
  "xl": "1200px — sidenotes at and above",
  "communeBand": "767px — the Commune band's own switch (max-width)",
  "ossRows": "1100px — Made with OSS rows drop the link column below this (max-width)"
 },
 "gradient": {
  "brand": "linear-gradient(90deg, #D4B8FF 0%, #F4A3BE 32%, #FF8B57 64%, #F3C460 100%)",
  "brandVertical": "linear-gradient(180deg, #D4B8FF 0%, #F4A3BE 32%, #FF8B57 64%, #F3C460 100%)",
  "logo": "linear-gradient(100deg, #D4B8FF 0%, #F4A3BE 32%, #FF8B57 64%, #F3C460 100%)",
  "cover": "linear-gradient(180deg, #D8C1FF 0%, #F3A7C6 34%, #FF9B66 66%, #F5CF73 100%)",
  "uses": "logo pill, active nav bar, docs current-page pill, active sidenote edge, 4px rule above the Commune band, share-image band, note covers. Never on text or buttons."
 },
 "color": {
  "bg": {
   "light": "#FFFFFF",
   "dark": "#0F0F11",
   "use": "page"
  },
  "bg.subtle": {
   "light": "#F5F5F4",
   "dark": "#1C1C1E",
   "use": "tiles, code, cards, inputs"
  },
  "bg.hover": {
   "light": "#EBEBE9",
   "dark": "#262628",
   "use": "hovered tiles and secondary buttons"
  },
  "bg.pressed": {
   "light": "#E2E2DF",
   "dark": "#303033",
   "use": "pressed, selected segment track"
  },
  "bg.raised": {
   "light": "#FFFFFF",
   "dark": "#3A3A3C",
   "use": "selected segment, kbd, input on bg.subtle"
  },
  "bg.inverted": {
   "light": "#1D1D1F",
   "dark": "#F5F5F7",
   "use": "primary buttons"
  },
  "bg.invertedHover": {
   "light": "#3A3A3C",
   "dark": "#D1D1D6",
   "use": "primary button hover"
  },
  "bg.code": {
   "light": "#1D1D1F",
   "dark": "#161618",
   "use": "terminals and dark code (dark: between bg and bg.subtle)"
  },
  "bg.glass": {
   "light": "rgba(255,255,255,0.62)",
   "dark": "rgba(15,15,17,0.66)",
   "use": "header, with saturate(180%) blur(20px)"
  },
  "bg.scrim": {
   "light": "rgba(29,29,31,0.30)",
   "dark": "rgba(0,0,0,0.60)",
   "use": "behind the search dialog, with blur(3px)"
  },
  "bg.commune": {
   "light": "#000000",
   "dark": "#000000",
   "use": "Commune band, both themes"
  },
  "fg": {
   "light": "#1D1D1F",
   "dark": "#F5F5F7",
   "use": "body and headings"
  },
  "fg.secondary": {
   "light": "#3A3A3C",
   "dark": "#D1D1D6",
   "use": "long-form secondary text"
  },
  "fg.muted": {
   "light": "#6E6E73",
   "dark": "#A1A1A6",
   "use": "labels, metadata, captions"
  },
  "fg.quiet": {
   "light": "#86868B",
   "dark": "#8E8E93",
   "use": "grey half of two-tone headlines"
  },
  "fg.inverted": {
   "light": "#FFFFFF",
   "dark": "#0F0F11",
   "use": "text on primary buttons"
  },
  "fg.onCode": {
   "light": "#F5F5F7",
   "dark": "#F5F5F7",
   "use": "text on bg.code"
  },
  "fg.communeBy": {
   "light": "#A1A1AA",
   "dark": "#A1A1AA",
   "use": "'By' in the Commune band"
  },
  "border": {
   "light": "#ECECEA",
   "dark": "#2A2A2D",
   "use": "hairlines, row dividers"
  },
  "border.strong": {
   "light": "#1D1D1F",
   "dark": "#F5F5F7",
   "use": "2px section rules (Made with OSS)"
  },
  "border.faint": {
   "light": "#C9C9C6",
   "dark": "#48484A",
   "use": "empty values, dashes"
  },
  "border.hover": {
   "light": "#D2D2D0",
   "dark": "#3A3A3C",
   "use": "header-link hover bar"
  },
  "border.header": {
   "light": "rgba(29,29,31,0.08)",
   "dark": "rgba(255,255,255,0.10)",
   "use": "header bottom edge"
  },
  "accent": {
   "light": "#2F5BE3",
   "dark": "#728FEC",
   "use": "in-copy links and focus rings only"
  },
  "highlight": {
   "light": "#FDDCCB",
   "dark": "rgba(255,139,87,0.34)",
   "use": "search match highlight, ::selection"
  }
 },
 "tone": {
  "$note": "Callout and status tones. tint = the tone at 12% over white (light) or 22% over bg (dark).",
  "note": {
   "light": "#2F5BE3",
   "dark": "#728FEC",
   "tintLight": "#E6EBFC",
   "tintDark": "#161F40"
  },
  "tip": {
   "light": "#23794A",
   "dark": "#69A484",
   "tintLight": "#E5EFE9",
   "tintDark": "#14261D"
  },
  "important": {
   "light": "#6E44D6",
   "dark": "#9C80E3",
   "tintLight": "#EEE9FA",
   "tintDark": "#251B3C"
  },
  "warning": {
   "light": "#A15C00",
   "dark": "#BF9052",
   "tintLight": "#F4EBE0",
   "tintDark": "#301F0D"
  },
  "caution": {
   "light": "#B42E24",
   "dark": "#CC716A",
   "tintLight": "#F6E6E5",
   "tintDark": "#331616"
  }
 },
 "shadow": {
  "dialog": {
   "light": "0 0 0 1px rgba(29,29,31,0.06), 0 24px 72px rgba(29,29,31,0.22)",
   "dark": "0 0 0 1px rgba(255,255,255,0.08), 0 24px 72px rgba(0,0,0,0.6)"
  },
  "segment": {
   "light": "0 1px 2px rgba(0,0,0,0.08)",
   "dark": "0 1px 2px rgba(0,0,0,0.4)"
  },
  "kbd": {
   "light": "inset 0 0 0 1px rgba(29,29,31,0.10)",
   "dark": "inset 0 0 0 1px rgba(255,255,255,0.14)"
  }
 },
 "motion": {
  "hover": "120ms ease-out (colour only)",
  "press": "scale(0.98) on buttons while held",
  "anatomy": "550ms cubic-bezier(.2,.7,.2,1)",
  "footnoteTarget": "tint fades out over 1.5s",
  "copyRevert": "1.6s",
  "reducedMotion": "no scale, no fades, no anatomy animation"
 },
 "focus": {
  "ring": "2px solid accent",
  "offset": "2px",
  "when": ":focus-visible only"
 },
 "textStyle": {
  "hero": {
   "fontSize": "clamp(44px, 6.4vw, 88px)",
   "fontWeight": 500,
   "lineHeight": 1.04,
   "letterSpacing": "-0.03em",
   "note": "Home"
  },
  "pageTitle": {
   "fontSize": "clamp(40px, 5.6vw, 76px)",
   "fontWeight": 500,
   "lineHeight": 1.04,
   "letterSpacing": "-0.03em",
   "note": "component, note, notes index, result pages (range 64–80px max by page; see boards)"
  },
  "section": {
   "fontSize": "clamp(34px, 4.4vw, 56px)",
   "fontWeight": 500,
   "lineHeight": 1.08,
   "letterSpacing": "-0.03em",
   "note": "home sections"
  },
  "docsH2": {
   "fontSize": "28px",
   "fontWeight": 500,
   "lineHeight": 1.15,
   "letterSpacing": "-0.02em"
  },
  "body": {
   "fontSize": "17px",
   "lineHeight": 1.5
  },
  "prose": {
   "fontSize": "19px",
   "lineHeight": 1.65,
   "note": "notes article; 17px under 760px"
  },
  "label": {
   "fontSize": "13px",
   "color": "fg.muted"
  },
  "mono": {
   "fontFamily": "mono",
   "fontSize": "13px"
  }
 }
}