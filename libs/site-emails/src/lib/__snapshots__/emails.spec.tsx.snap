exports[`renderAlreadySubscribedEmail > ships a hand-written plain-text part 1`] = `
"You’re already on the list.

Nothing to do. The next email comes with the next release.

--
You’re getting this because someone entered this address at postkit.org.
Unsubscribe: https://postkit.org/newsletter/unsubscribe?token=unsubscribe-token_XYZ
Privacy: https://postkit.org/privacy
Postkit, by Commune Software · 1870 The Exchange SE Ste 220, PMB 980007, Atlanta, GA 30339-2171
"
`;

exports[`renderAlreadySubscribedEmail > uses the confirm layout with no button 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html lang="en"><head><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/><meta name="color-scheme" content="light only"/><meta name="supported-color-schemes" content="light"/><title>You’re already getting Postkit release emails</title></head><body bgcolor="#F5F5F4" style="padding:0px;margin:0px;width:100%;background-color:#F5F5F4;color:#1D1D1F;font-family:&#x27;Inter Tight&#x27;, -apple-system, &#x27;Segoe UI&#x27;, Helvetica, Arial, sans-serif"><div aria-hidden="true" style="display:none;font-size:1px;color:#ffffff;line-height:1px;max-height:0px;max-width:0px;overflow:hidden;visibility:hidden;opacity:0;mso-hide:all">Nothing to do. The next email comes with the next release.<span style="display:none;mso-hide:all"> ‌ ‌ ‌ ‌ ‌ </span></div><table role="presentation" cellSpacing="0" cellPadding="0" border="0" width="600" align="center" style="width:100%;max-width:600px"><tbody><tr><td style="padding-top:40px;padding-right:20px;padding-bottom:48px;padding-left:20px"><a href="https://postkit.org/" style="color:#1D1D1F;font-size:18px;font-weight:500;letter-spacing:-0.02em;text-decoration:none"><span aria-hidden="true" style="background-color:#FF8B57;width:30px;height:16px;border-radius:999px;display:inline-block;vertical-align:middle;background-image:linear-gradient(100deg, #D4B8FF 0%, #F4A3BE 32%, #FF8B57 64%, #F3C460 100%)"></span><span style="display:inline-block;vertical-align:middle;margin-left:9px">Postkit</span></a><table bgcolor="#FFFFFF" role="presentation" cellSpacing="0" cellPadding="0" border="0" width="100%" style="width:100%;background-color:#FFFFFF;margin-top:20px;border-radius:20px"><tbody><tr><td style="padding-top:40px;padding-right:40px;padding-bottom:44px;padding-left:40px"><h1 style="font-family:&#x27;Inter Tight&#x27;, -apple-system, &#x27;Segoe UI&#x27;, Helvetica, Arial, sans-serif;color:#1D1D1F;margin:0px;font-size:30px;font-weight:500;line-height:1.15;letter-spacing:-0.02em">You’re already on the list.</h1><p style="color:#3A3A3C;margin:0px;margin-top:16px;font-size:16px;line-height:1.6">Nothing to do. The next email comes with the next release.</p></td></tr></tbody></table><table role="presentation" cellSpacing="0" cellPadding="0" border="0" width="100%" style="width:100%"><tbody><tr><td style="padding-top:24px;padding-right:8px;padding-left:8px"><p style="color:#86868B;margin:0px;margin-top:0px;font-size:12.5px;line-height:1.6">You’re getting this because someone entered this address at postkit.org.</p><p style="color:#86868B;margin:0px;margin-top:8px;font-size:12.5px;line-height:1.6"><a href="https://postkit.org/newsletter/unsubscribe?token=unsubscribe-token_XYZ" style="text-decoration:underline;color:#6E6E73">Unsubscribe</a> · <a href="https://postkit.org/privacy" style="text-decoration:underline;color:#6E6E73">Privacy</a></p><p style="color:#86868B;margin:0px;margin-top:8px;font-size:12.5px;line-height:1.6">Postkit, by Commune Software · 1870 The Exchange SE Ste 220, PMB 980007, <span style="white-space:nowrap">Atlanta, GA 30339-2171</span></p></td></tr></tbody></table></td></tr></tbody></table></body></html>"`;

exports[`renderConfirmEmail > matches the EmailConfirm board 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html lang="en"><head><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/><meta name="color-scheme" content="light only"/><meta name="supported-color-schemes" content="light"/><title>Confirm your Postkit release emails</title></head><body bgcolor="#F5F5F4" style="padding:0px;margin:0px;width:100%;background-color:#F5F5F4;color:#1D1D1F;font-family:&#x27;Inter Tight&#x27;, -apple-system, &#x27;Segoe UI&#x27;, Helvetica, Arial, sans-serif"><div aria-hidden="true" style="display:none;font-size:1px;color:#ffffff;line-height:1px;max-height:0px;max-width:0px;overflow:hidden;visibility:hidden;opacity:0;mso-hide:all">One click and you’ll get an email each time Postkit ships.<span style="display:none;mso-hide:all"> ‌ ‌ ‌ ‌ ‌ </span></div><table role="presentation" cellSpacing="0" cellPadding="0" border="0" width="600" align="center" style="width:100%;max-width:600px"><tbody><tr><td style="padding-top:40px;padding-right:20px;padding-bottom:48px;padding-left:20px"><a href="https://postkit.org/" style="color:#1D1D1F;font-size:18px;font-weight:500;letter-spacing:-0.02em;text-decoration:none"><span aria-hidden="true" style="background-color:#FF8B57;width:30px;height:16px;border-radius:999px;display:inline-block;vertical-align:middle;background-image:linear-gradient(100deg, #D4B8FF 0%, #F4A3BE 32%, #FF8B57 64%, #F3C460 100%)"></span><span style="display:inline-block;vertical-align:middle;margin-left:9px">Postkit</span></a><table bgcolor="#FFFFFF" role="presentation" cellSpacing="0" cellPadding="0" border="0" width="100%" style="width:100%;background-color:#FFFFFF;margin-top:20px;border-radius:20px"><tbody><tr><td style="padding-top:40px;padding-right:40px;padding-bottom:44px;padding-left:40px"><h1 style="font-family:&#x27;Inter Tight&#x27;, -apple-system, &#x27;Segoe UI&#x27;, Helvetica, Arial, sans-serif;color:#1D1D1F;margin:0px;font-size:30px;font-weight:500;line-height:1.15;letter-spacing:-0.02em">Confirm your email</h1><p style="color:#3A3A3C;margin:0px;margin-top:16px;font-size:16px;line-height:1.6">Click below and you’ll get one email each time Postkit ships a release. Nothing else.</p><table role="presentation" cellSpacing="0" cellPadding="0" border="0" width="100%" style="width:100%;margin-top:28px"><tbody><tr><td><table role="presentation" cellSpacing="0" cellPadding="0" border="0" align="left" style="border-collapse:separate"><tbody><tr><td bgcolor="#1D1D1F" align="center" style="background-color:#1D1D1F;border-radius:999px;mso-padding-alt:14px 24px 14px 24px"><a href="https://postkit.org/api/newsletter/confirm?token=confirm-token_ABC" style="font-family:&#x27;Inter Tight&#x27;, -apple-system, &#x27;Segoe UI&#x27;, Helvetica, Arial, sans-serif;text-align:center;text-decoration:none;color:#FFFFFF;padding-left:24px;padding-right:24px;padding-top:14px;padding-bottom:14px;font-size:15px;font-weight:500;line-height:1.2;display:inline-block">Confirm subscription</a></td></tr></tbody></table></td></tr></tbody></table><p style="color:#6E6E73;margin:0px;margin-top:28px;font-size:14px;line-height:1.55">The link works for 7 days. If you didn’t ask for this, ignore this email and nothing happens.</p></td></tr></tbody></table><table role="presentation" cellSpacing="0" cellPadding="0" border="0" width="100%" style="width:100%"><tbody><tr><td style="padding-top:24px;padding-right:8px;padding-left:8px"><p style="color:#86868B;margin:0px;margin-top:0px;font-size:12.5px;line-height:1.6">You’re getting this because someone entered this address at postkit.org.</p><p style="color:#86868B;margin:0px;margin-top:8px;font-size:12.5px;line-height:1.6"><a href="https://postkit.org/privacy" style="text-decoration:underline;color:#6E6E73">Privacy</a></p><p style="color:#86868B;margin:0px;margin-top:8px;font-size:12.5px;line-height:1.6">Postkit, by Commune Software · 1870 The Exchange SE Ste 220, PMB 980007, <span style="white-space:nowrap">Atlanta, GA 30339-2171</span></p></td></tr></tbody></table></td></tr></tbody></table></body></html>"`;

exports[`renderConfirmEmail > ships a hand-written plain-text part 1`] = `
"Confirm your email

Open the link below and you’ll get one email each time Postkit ships a release. Nothing else.

Confirm subscription: https://postkit.org/api/newsletter/confirm?token=confirm-token_ABC

The link works for 7 days. If you didn’t ask for this, ignore this email and nothing happens.

--
You’re getting this because someone entered this address at postkit.org.
Privacy: https://postkit.org/privacy
Postkit, by Commune Software · 1870 The Exchange SE Ste 220, PMB 980007, Atlanta, GA 30339-2171
"
`;
