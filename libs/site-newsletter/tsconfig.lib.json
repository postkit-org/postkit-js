{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "lib": ["es2022", "dom"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../site-emails/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vitest.config.mts",
    "src/testing/**",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
