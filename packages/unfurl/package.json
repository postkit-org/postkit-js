{
  "name": "@postkit/unfurl",
  "version": "0.1.1",
  "description": "Provider-neutral link metadata resolution for Postkit",
  "keywords": [
    "postkit",
    "publishing",
    "structured-content",
    "typescript",
    "unfurl",
    "url-metadata",
    "link-preview",
    "open-graph",
    "opengraph",
    "oembed",
    "social-media",
    "metadata",
    "resolver"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postkit-org/postkit-js.git",
    "directory": "packages/unfurl"
  },
  "homepage": "https://github.com/postkit-org/postkit-js/tree/main/packages/unfurl#readme",
  "bugs": {
    "url": "https://github.com/postkit-org/postkit-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@postkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "nx": {
    "tags": [
      "npm:public",
      "scope:postkit",
      "layer:foundation"
    ]
  }
}
