{
  "name": "@postkit/react",
  "version": "0.2.0",
  "description": "Headless, styleable React views for Postkit components",
  "keywords": [
    "postkit",
    "publishing",
    "structured-content",
    "typescript",
    "react",
    "headless",
    "mdx",
    "content-components",
    "article-components",
    "markdown",
    "remark"
  ],
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postkit-org/postkit-js.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/postkit-org/postkit-js/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/postkit-org/postkit-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@postkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./remark": {
      "@postkit/source": "./src/remark.ts",
      "types": "./dist/remark.d.ts",
      "import": "./dist/remark.js",
      "default": "./dist/remark.js"
    },
    "./kits": {
      "@postkit/source": "./src/kits/index.ts",
      "types": "./dist/kits/index.d.ts",
      "import": "./dist/kits/index.js",
      "default": "./dist/kits/index.js"
    },
    "./kits/article": {
      "@postkit/source": "./src/kits/article.ts",
      "types": "./dist/kits/article.d.ts",
      "import": "./dist/kits/article.js",
      "default": "./dist/kits/article.js"
    },
    "./kits/technical": {
      "@postkit/source": "./src/kits/technical.ts",
      "types": "./dist/kits/technical.d.ts",
      "import": "./dist/kits/technical.js",
      "default": "./dist/kits/technical.js"
    },
    "./kits/media": {
      "@postkit/source": "./src/kits/media.ts",
      "types": "./dist/kits/media.d.ts",
      "import": "./dist/kits/media.js",
      "default": "./dist/kits/media.js"
    },
    "./kits/discovery": {
      "@postkit/source": "./src/kits/discovery.ts",
      "types": "./dist/kits/discovery.d.ts",
      "import": "./dist/kits/discovery.js",
      "default": "./dist/kits/discovery.js"
    },
    "./kits/engagement": {
      "@postkit/source": "./src/kits/engagement.ts",
      "types": "./dist/kits/engagement.d.ts",
      "import": "./dist/kits/engagement.js",
      "default": "./dist/kits/engagement.js"
    },
    "./kits/publishing": {
      "@postkit/source": "./src/kits/publishing.ts",
      "types": "./dist/kits/publishing.d.ts",
      "import": "./dist/kits/publishing.js",
      "default": "./dist/kits/publishing.js"
    }
  },
  "files": [
    "dist",
    "dist/styles.css",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@postkit/core": "0.2.0",
    "@postkit/unfurl": "0.2.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tslib": "^2.3.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "@zag-js/carousel": "^1.27.0",
    "@zag-js/clipboard": "^1.27.0",
    "@zag-js/core": "^1.27.0",
    "@zag-js/react": "^1.27.0",
    "@zag-js/tabs": "^1.27.0",
    "@zag-js/types": "^1.27.0",
    "react": "^19.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "nx": {
    "tags": [
      "npm:public",
      "scope:postkit",
      "layer:react"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "cwd": "packages/react",
          "commands": [
            "tsc --build tsconfig.lib.json",
            "node scripts/build-styles.mjs"
          ],
          "parallel": false
        }
      }
    }
  },
  "peerDependenciesMeta": {
    "@zag-js/carousel": {
      "optional": true
    },
    "@zag-js/clipboard": {
      "optional": true
    },
    "@zag-js/core": {
      "optional": true
    },
    "@zag-js/react": {
      "optional": true
    },
    "@zag-js/tabs": {
      "optional": true
    },
    "@zag-js/types": {
      "optional": true
    }
  }
}
