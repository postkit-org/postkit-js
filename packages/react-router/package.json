{
  "name": "@postkit/react-router",
  "version": "0.1.1",
  "description": "Postkit MDX components and link routing for React Router",
  "keywords": [
    "postkit",
    "publishing",
    "structured-content",
    "typescript",
    "react",
    "react-router",
    "markdown",
    "mdx",
    "routing",
    "content-components"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postkit-org/postkit-js.git",
    "directory": "packages/react-router"
  },
  "homepage": "https://github.com/postkit-org/postkit-js#readme",
  "bugs": {
    "url": "https://github.com/postkit-org/postkit-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@postkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@types/mdx": "^2.0.14",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@postkit/react": "0.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": ">=7 <8"
  },
  "devDependencies": {
    "react-router": "^7.18.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "nx": {
    "tags": [
      "npm:public",
      "scope:postkit",
      "layer:adapter"
    ]
  }
}
