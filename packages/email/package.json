{
  "name": "@postkit/email",
  "version": "0.2.0",
  "description": "Email-safe Postkit components rendered with Chakra Email primitives",
  "keywords": [
    "postkit",
    "publishing",
    "structured-content",
    "typescript",
    "react",
    "email",
    "email-components",
    "email-templates",
    "html-email",
    "transactional-email",
    "chakra-email",
    "markdown",
    "mdx"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postkit-org/postkit-js.git",
    "directory": "packages/email"
  },
  "homepage": "https://github.com/postkit-org/postkit-js/tree/main/packages/email#readme",
  "bugs": {
    "url": "https://github.com/postkit-org/postkit-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@postkit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@chakra-email/core": "^0.1.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "nx": {
    "tags": [
      "npm:public",
      "scope:postkit",
      "layer:renderer"
    ]
  }
}
