{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/globals", "vite/client", "node", "vitest"],
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom"]
  },
  "include": ["vite.config.ts", "src/**/*.spec.ts", "src/**/*.spec.tsx"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
