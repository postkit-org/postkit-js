{
  "name": "site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/site/src",
  "projectType": "application",
  "tags": ["npm:private", "scope:postkit", "type:app"],
  "// targets": "to see all targets run: nx show project site --web",
  "targets": {
    "dev": {
      "dependsOn": [
        {
          "projects": ["@postkit/content"],
          "target": "build"
        },
        "feeds",
        "icons"
      ]
    },
    "feeds": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/scripts/build-feeds.mts",
        "^production",
        {
          "externalDependencies": ["@chakra-docs/feed"]
        },
        {
          "env": "NEXT_PUBLIC_SITE_URL"
        }
      ],
      "outputs": ["{projectRoot}/public/feeds"],
      "options": {
        "cwd": "apps/site",
        "command": "node scripts/build-feeds.mts",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "icons": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/scripts/build-icons.mts",
        "{workspaceRoot}/docs/design/handoff/assets/brand/favicon.svg",
        "^production",
        {
          "externalDependencies": ["sharp", "jiti"]
        }
      ],
      "outputs": [
        "{projectRoot}/public/favicon.svg",
        "{projectRoot}/public/favicon.ico",
        "{projectRoot}/public/apple-touch-icon.png",
        "{projectRoot}/public/icon-192.png",
        "{projectRoot}/public/icon-512.png",
        "{projectRoot}/public/site.webmanifest"
      ],
      "options": {
        "cwd": "apps/site",
        "command": "node scripts/build-icons.mts"
      }
    },
    "build": {
      "dependsOn": ["^build", "feeds", "icons"],
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["next"]
        },
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        },
        {
          "env": "NEXT_PUBLIC_FATHOM_SITE_ID"
        },
        {
          "env": "NEXT_PUBLIC_SENTRY_DSN"
        },
        {
          "env": "SENTRY_AUTH_TOKEN"
        },
        {
          "env": "SENTRY_ORG"
        },
        {
          "env": "SENTRY_PROJECT"
        },
        {
          "env": "NEXT_PUBLIC_SITE_URL"
        }
      ],
      "options": {
        "env": {
          "NODE_ENV": "production"
        }
      }
    }
  }
}
