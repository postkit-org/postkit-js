{
  "name": "site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/site/src",
  "projectType": "application",
  "tags": ["npm:private", "scope:postkit", "type:app"],
  "// targets": "to see all targets run: nx show project site --web",
  "targets": {
    "dev": {
      "dependsOn": [
        {
          "projects": ["@postkit/content"],
          "target": "build"
        }
      ]
    },
    "build": {
      "inputs": [
        "default",
        "^default",
        { "externalDependencies": ["next"] },
        { "dependentTasksOutputFiles": "**/*.d.ts", "transitive": true },
        { "env": "NEXT_PUBLIC_FATHOM_SITE_ID" },
        { "env": "NEXT_PUBLIC_SENTRY_DSN" },
        { "env": "SENTRY_AUTH_TOKEN" },
        { "env": "SENTRY_ORG" },
        { "env": "SENTRY_PROJECT" }
      ],
      "options": {
        "env": {
          "NODE_ENV": "production"
        }
      }
    }
  }
}
