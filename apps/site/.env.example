# Postkit site: analytics and error reporting (PK-004).
# Every variable is optional. Leave one empty and its integration stays off: no script, no
# requests, no events. Copy to .env.local (never commit values) or set them in Vercel.

# Optional. Fathom site ID; without it react-fathom isn't mounted and Fathom's script never loads.
NEXT_PUBLIC_FATHOM_SITE_ID=

# Optional. Sentry DSN; without it Sentry.init is never called and no tunnel route is added.
NEXT_PUBLIC_SENTRY_DSN=

# Optional (CI only). Sentry auth token; without it builds skip source-map upload quietly.
SENTRY_AUTH_TOKEN=

# Optional. Sentry organization slug for source-map upload; unused without SENTRY_AUTH_TOKEN.
SENTRY_ORG=

# Optional. Sentry project slug for source-map upload; unused without SENTRY_AUTH_TOKEN.
SENTRY_PROJECT=

# Release emails (PK-050, docs/design/handoff/specs/04-emails.md §5). Server-only, read at
# runtime. Without all three of RESEND_API_KEY, RESEND_AUDIENCE_ID and SUBSCRIBE_SECRET, the
# subscribe API answers 503 "unavailable", sends nothing, and the build still passes.

# Optional. Resend API key: sending, the audience and broadcasts. Never set RESEND_DEBUG with
# it: the SDK would log request paths, which contain addresses (the site forces it off anyway).
RESEND_API_KEY=

# Optional. The ID of the "Postkit releases" audience in Resend. Before launch, create the
# `unsubscribe_token` contact property (type string) and turn open and click tracking off on
# the postkit.org sending domain.
RESEND_AUDIENCE_ID=

# Optional. AES-256-GCM key for the sealed confirm and unsubscribe tokens: exactly 32 random
# bytes, base64-encoded (`openssl rand -base64 32`). Rotating it breaks every unsubscribe link
# already sent and every stored unsubscribe_token, so set it once per environment.
SUBSCRIBE_SECRET=

# Optional. The origin for links in emails and feeds; https://postkit.org when empty. Preview
# deploys set their own URL so confirm and unsubscribe links come back to the preview.
NEXT_PUBLIC_SITE_URL=
