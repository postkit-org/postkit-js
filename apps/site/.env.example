# Postkit site: analytics and error reporting (PK-004).
# Every variable is optional. Leave one empty and its integration stays off: no script, no
# requests, no events. Copy to .env.local (never commit values) or set them in Vercel.

# Optional. Fathom site ID; without it react-fathom isn't mounted and Fathom's script never loads.
NEXT_PUBLIC_FATHOM_SITE_ID=

# Optional. Sentry DSN; without it Sentry.init is never called and no tunnel route is added.
NEXT_PUBLIC_SENTRY_DSN=

# Optional (CI only). Sentry auth token; without it builds skip source-map upload quietly.
SENTRY_AUTH_TOKEN=

# Optional. Sentry organization slug for source-map upload; unused without SENTRY_AUTH_TOKEN.
SENTRY_ORG=

# Optional. Sentry project slug for source-map upload; unused without SENTRY_AUTH_TOKEN.
SENTRY_PROJECT=
