---
import { postkitAstroComponents } from '@postkit/astro/components';
// The canonical sample article, shared with the Chakra example.
import Article from '../../../astro/src/content/article.mdx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Postkit Astro headless example</title>
  </head>
  <body>
    <main>
      <Article components={postkitAstroComponents} />
    </main>
  </body>
</html>
